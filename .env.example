# ─────────────────────────────────────────────────────────
# Root Environment Example
# Copy this file to .env and fill in real values.
# NEVER commit a .env file containing real credentials.
# ─────────────────────────────────────────────────────────

# ── Node Environment ──────────────────────────────────────
# Values: development | test | production
NODE_ENV=development

# ── Frontend (Next.js) ───────────────────────────────────
# All NEXT_PUBLIC_ variables are embedded in the browser bundle.
# Do NOT put secrets in NEXT_PUBLIC_ variables.

# The canonical public URL of the frontend (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The base URL the frontend uses to call the backend API.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── Backend (Express) ─────────────────────────────────────
# The port the Express server listens on.
PORT=4000

# A long, random secret used to sign session tokens / JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# ── Database (MongoDB Atlas) ───────────────────────────────
# Format: mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
# Configures the active MongoDB Atlas database for PERALAGAE e-commerce.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ecom?retryWrites=true&w=majority

# ── Company / Tenant Identity ─────────────────────────────
# Each company deployment sets its own identity here.
# See packages/shared-types/src/company.ts and docs/ for the full list.
COMPANY_ID=acme-jewellers
COMPANY_NAME="Acme Jewellers"
COMPANY_DOMAIN=localhost

# ── Payment Provider (Razorpay Standard Checkout) ─────────
# In Test mode, use Test Key ID (rzp_test_...) and Test Key Secret from Razorpay Dashboard.
# Never expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to frontend code.
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_TEST_WEBHOOK_SECRET
RAZORPAY_MODE=test
FRONTEND_URL=http://localhost:3000

# ── Email Provider ────────────────────────────────────────
# Populate when integrating an email service.
EMAIL_PROVIDER=PLACEHOLDER
EMAIL_API_KEY=PLACEHOLDER
EMAIL_FROM_ADDRESS=noreply@example.com

# ── Feature Flags ─────────────────────────────────────────
# true | false
FEATURE_GOLD_RATE_LIVE=false
FEATURE_PAYMENTS_ENABLED=false
FEATURE_SHIPPING_ENABLED=false
