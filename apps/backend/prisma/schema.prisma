// Prisma Schema — PERALAGAE Jewellery E-commerce
//
// Baseline database schema foundation.
// In accordance with backend foundation setup requirements:
// - No business domain models (products, categories, users, orders, cart, etc.) are implemented here.
// - PostgreSQL datasource configured via DATABASE_URL environment variable.
// - A minimal technical HealthCheck model is provided so Prisma schema syntax remains valid.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// Baseline technical model (syntactic validity only; no business models)
// ──────────────────────────────────────────────────────────────────────────

model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  @@map("health_checks")
}

// ──────────────────────────────────────────────────────────────────────────
// Navbar Management Models (Top Bar & Second Navbar Settings and History)
// ──────────────────────────────────────────────────────────────────────────

model NavbarSetting {
  id                String   @id @default("current")
  topBarText        String   @default("")
  topBarBgColor     String   @default("#FBC0CE")
  topBarTextColor   String   @default("#222222")
  topBarVisible     Boolean  @default(true)
  topBarDismissible Boolean  @default(true)

  secondPhone        String   @default("+91 98765 43210")
  secondPhoneHref    String   @default("tel:+919876543210")
  secondPromoText    String   @default("")
  secondCtaText      String   @default("Shop Now!")
  secondCtaHref      String   @default("/shop")
  secondLinks        Json     @default("[]")
  secondPhoneVisible Boolean  @default(true)
  secondPromoVisible Boolean  @default(true)
  secondLinksVisible Boolean  @default(true)

  version             Int      @default(1)
  topBarVersion       Int      @default(1)
  secondNavbarVersion Int      @default(1)
  updatedAt           DateTime @updatedAt
  updatedBy           String?

  @@map("navbar_settings")
}

model NavbarHistory {
  id          String   @id @default(cuid())
  section     String   // "TOP_BAR" | "SECOND_NAVBAR" | "top_bar" | "second_navbar" | "full"
  snapshot    Json     // Full snapshot of settings at this version
  description String?
  version     Int
  createdAt   DateTime @default(now())
  createdBy   String?

  @@map("navbar_history")
}

// ──────────────────────────────────────────────────────────────────────────
// Hero Banner Management Models (Settings, Independent Slot History, Media)
// ──────────────────────────────────────────────────────────────────────────

model HeroSetting {
  id                String   @id @default("current")
  heroImage1        Json     // HeroImageSlot1
  heroImage2        Json     // HeroImageSlot2
  heroImage3        Json     // HeroImageSlot3
  heroImage1Version Int      @default(1)
  heroImage2Version Int      @default(1)
  heroImage3Version Int      @default(1)
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt
  updatedBy         String?

  @@map("hero_settings")
}

model HeroHistory {
  id             String   @id @default(cuid())
  slotId         String   // "heroImage1" | "heroImage2" | "heroImage3"
  snapshot       Json?    // Optional full slot snapshot
  version        Int
  imageUrl       String
  normalHeadline String
  boldHeadline   String
  description    String?
  createdAt      DateTime @default(now())
  createdBy      String?

  @@map("hero_history")
}

model HeroMediaAsset {
  id        String   @id // Unique identifier / filename
  filename  String   @unique
  mimeType  String
  size      Int
  data      Bytes    // Native PostgreSQL bytea binary storage (NOT base64)
  createdAt DateTime @default(now())

  @@map("hero_media_assets")
}

// ──────────────────────────────────────────────────────────────────────────
// Category and Product Catalogue Models
// ──────────────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  imageUrl    String
  imageAlt    String?
  description String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  categoryId        String?
  categoryKey       String?   // E.g. "NECKLACES", "RINGS", matching legacy category key
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageUrl          String
  imageAlt          String?
  priceInr          Float     @default(0)
  compareAtPriceInr Float?
  isHot             Boolean   @default(false)
  isNew             Boolean   @default(false)
  isAvailable       Boolean   @default(true)
  inStock           Boolean   @default(true)
  stockCount        Int       @default(10)
  material          String?
  materials         Json?     @default("[]")
  sizes             Json?     @default("[]")
  images            Json?     @default("[]")
  description       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("products")
}

model CategoryMediaAsset {
  id        String   @id // Unique identifier / filename
  filename  String   @unique
  mimeType  String
  size      Int
  data      Bytes    // Native PostgreSQL bytea binary storage (NOT base64)
  createdAt DateTime @default(now())

  @@map("category_media_assets")
}

