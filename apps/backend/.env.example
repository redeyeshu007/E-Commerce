# PERALAGAE Jewellery E-commerce — Backend Environment Configuration
# Copy this template to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit real credentials or actual connection strings to version control.
# - The backend validates all variables at startup using Zod.

# Runtime environment (development | test | production)
NODE_ENV=development

# HTTP server port
PORT=4000

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Required for active database connectivity and production.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ecom?retryWrites=true&w=majority

# Allowed CORS origins for the frontend (comma-separated for multiple origins)
# Example: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000

# Logging level (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Initial Admin Credentials (Phase 1 — Admin Authentication Only)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Customer Authentication & Google OAuth
CUSTOMER_JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Standard Checkout Payment Gateway
# In Test mode, use Test Key ID (rzp_test_...) and Test Key Secret from Razorpay Dashboard.
# Never expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to frontend code.
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_TEST_WEBHOOK_SECRET
RAZORPAY_MODE=test
FRONTEND_URL=http://localhost:3000

# SMTP Email Notification System (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-app-password
EMAIL_FROM=notifications@peralagae.com
EMAIL_FROM_NAME=PERALAGAE Jewellery
EMAIL_REPLY_TO=support@peralagae.com
EMAIL_ENABLED=true
BUSINESS_TIMEZONE=Asia/Kolkata


