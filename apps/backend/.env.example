# Backend Environment Example
# Copy to apps/backend/.env for local development.
# NEVER commit a .env file containing real credentials.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Local PostgreSQL — see docs/development-setup.md
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gold_commerce_dev?schema=public

# Company identity
COMPANY_ID=acme-jewellers
COMPANY_NAME="Acme Jewellers"
COMPANY_DOMAIN=localhost

# Feature flags
FEATURE_GOLD_RATE_LIVE=false
FEATURE_PAYMENTS_ENABLED=false
FEATURE_SHIPPING_ENABLED=false

# Payment provider (populate when integrating)
PAYMENT_PROVIDER=PLACEHOLDER
PAYMENT_API_KEY=PLACEHOLDER
PAYMENT_WEBHOOK_SECRET=PLACEHOLDER

# Email provider (populate when integrating)
EMAIL_PROVIDER=PLACEHOLDER
EMAIL_API_KEY=PLACEHOLDER
EMAIL_FROM_ADDRESS=noreply@example.com
